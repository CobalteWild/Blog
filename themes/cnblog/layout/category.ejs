<% if (page.type === 'categories' && !page.category) { %>
  <article class="post-card archive-page">
    <h1 class="post-title">分类</h1>
    <% if (site.categories.length) { %>
      <div class="cat-list">
        <% site.categories.sort('-length').each(function (cat) { %>
          <%
            var catFull = decodeURIComponent(cat.path || '')
              .replace(/^categories\//, '')
              .replace(/\/$/, '');
            if (!catFull) catFull = cat.name;
            var catDepth = catFull.split('/').length - 1;
          %>
          <a class="cat-item<%- catDepth > 0 ? ' cat-child' : '' %>" href="<%- url_for(cat.path) %>">
            <span class="cat-name"><%- catFull %></span>
            <em class="cat-count"><%- cat.length %></em>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="empty-tip">还没有分类。</p>
    <% } %>
  </article>
<% } else { %>
  <%- partial('archive') %>
<% } %>
